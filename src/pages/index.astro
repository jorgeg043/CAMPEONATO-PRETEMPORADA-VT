---
import Layout from '../layouts/Layout.astro';
import calendario from '../data/calendario.json';
import pilotos from '../data/pilotos.json';

// Lógica de separación: Próxima carrera vs Resto de la temporada
const proximaCarrera = calendario.find((c) => c.estado === 'proxima') || calendario[0];
const restoCarreras = calendario.filter((c) => c.numeroFecha !== proximaCarrera.numeroFecha);
---

<Layout>
	<section class="max-w-6xl mx-auto px-4 py-8 space-y-16">
		
		<!-- 1. HERO SECTION & BOTÓN INSCRIPCIÓN -->
		<div class="flex flex-col items-center justify-center text-center pt-6">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/60 border border-red-800/50 text-red-400 text-xs font-mono uppercase tracking-widest mb-6 shadow-[0_0_15px_rgba(225,6,0,0.3)]">
				<span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
				Temporada Oficial 2026
			</div>

			<h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter mb-4">
				<span class="bg-gradient-to-r from-red-500 via-red-600 to-red-400 bg-clip-text text-transparent drop-shadow-[0_0_35px_rgba(225,6,0,0.6)]">
					Bienvenidos al
				</span>
				<br />
				<span class="text-white drop-shadow-[0_0_15px_rgba(255,255,255,0.7)]">
					Campeonato Pretemporada VT
				</span>
			</h1>
			
			<p class="text-gray-400 max-w-2xl text-base md:text-lg mb-8 font-mono">
				La grilla de salida está lista. Reservá tu lugar y demostrá quién manda en la pista antes del inicio de la temporada.
			</p>

			<!-- Botón Google Forms -->
			<a 
				href="https://docs.google.com/forms/d/e/1FAIpQLSebFbwAJF2RS-SAx8WFCUnn6lPf55tsH5Q9Z6eWEGg1FNB07w/viewform?usp=publish-editor" 
				target="_blank" 
				rel="noopener noreferrer"
				class="bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-black py-4 px-8 rounded-xl transition-all duration-300 text-lg uppercase tracking-widest shadow-[0_0_25px_rgba(225,6,0,0.6)] hover:shadow-[0_0_40px_rgba(225,6,0,0.9)] hover:-translate-y-1"
			>
				Completar Formulario
			</a>
		</div>

		<!-- 2. TARJETA DESTACADA COMPLETA: PRÓXIMA CARRERA -->
		<div class="relative bg-gradient-to-b from-[#140505] to-[#0a0a0a] rounded-3xl border border-red-600/70 p-6 md:p-10 shadow-[0_0_50px_rgba(225,6,0,0.25)] overflow-hidden">
			<!-- Resplandor neón ambiental -->
			<div class="absolute -top-24 -right-24 w-72 h-72 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

			<!-- Cabecera de la Próxima Fecha -->
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-8 border-b border-neutral-800/80 pb-6">
				<div>
					<span class="inline-block text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full bg-red-600/20 text-red-400 border border-red-600/40 mb-2">
						Próximo Evento • Fecha {proximaCarrera.numeroFecha}
					</span>
					<h2 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight flex items-center gap-3">
						<span>{proximaCarrera.bandera}</span> {proximaCarrera.pais}
					</h2>
					<p class="text-gray-400 font-mono text-sm mt-1">{proximaCarrera.circuito}</p>
				</div>
				
				<!-- Fecha y Hora -->
				<div class="flex items-center gap-6 bg-black/60 px-6 py-3 rounded-2xl border border-neutral-800 font-mono">
					<div>
						<span class="block text-[10px] text-gray-500 uppercase">Fecha</span>
						<span class="text-lg font-bold text-red-500">{proximaCarrera.fechaGranPremio}</span>
					</div>
					<div class="w-px h-8 bg-neutral-800"></div>
					<div>
						<span class="block text-[10px] text-gray-500 uppercase">Hora</span>
						<span class="text-lg font-bold text-white">{proximaCarrera.hora} HS</span>
					</div>
				</div>
			</div>

			<!-- Cuerpo Principal: Imagen PNG + Telemetría y Compuestos -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center mb-6">
				
				<!-- Imagen del Circuito PNG -->
				<div class="bg-black/80 rounded-2xl p-6 border border-neutral-900 flex justify-center items-center min-h-[200px]">
					<img 
						src={proximaCarrera.imagenCircuito} 
						alt={proximaCarrera.circuito} 
						class="max-h-48 object-contain filter drop-shadow-[0_0_12px_rgba(255,255,255,0.25)] hover:scale-105 transition-transform duration-300"
						onerror="this.style.display='none'"
					/>
				</div>

				<!-- Telemetría Técnica y Neumáticos -->
				<div class="space-y-6">
					
					<!-- Ficha Técnica -->
					<div>
						<span class="block text-xs font-mono text-gray-500 uppercase mb-2">Especificaciones del Trazado</span>
						<div class="grid grid-cols-3 gap-3 bg-neutral-900/60 p-4 rounded-xl border border-neutral-800 text-center font-mono">
							<div>
								<span class="block text-[10px] text-gray-500 uppercase">Longitud</span>
								<span class="text-sm md:text-base font-bold text-white">{proximaCarrera.distanciaKm}</span>
							</div>
							<div class="border-x border-neutral-800">
								<span class="block text-[10px] text-gray-500 uppercase">Curvas</span>
								<span class="text-sm md:text-base font-bold text-white">{proximaCarrera.curvas}</span>
							</div>
							<div>
								<span class="block text-[10px] text-gray-500 uppercase">Zonas DRS</span>
								<span class="text-sm md:text-base font-bold text-red-500">{proximaCarrera.zonasDrs}</span>
							</div>
						</div>
					</div>

					<!-- Compuestos Neumáticos -->
					<div>
						<span class="block text-xs font-mono text-gray-500 uppercase mb-2">Compuestos de Neumáticos</span>
						<div class="flex flex-wrap gap-3 font-mono text-xs">
							<span class="px-3 py-1.5 rounded-lg bg-red-950/80 border border-red-600 text-red-400 font-bold flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
								Blando: {proximaCarrera.compuestos.blando}
							</span>
							<span class="px-3 py-1.5 rounded-lg bg-yellow-950/80 border border-yellow-600 text-yellow-400 font-bold flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-yellow-500"></span>
								Medio: {proximaCarrera.compuestos.medio}
							</span>
							<span class="px-3 py-1.5 rounded-lg bg-neutral-800 border border-neutral-600 text-gray-300 font-bold flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-white"></span>
								Duro: {proximaCarrera.compuestos.duro}
							</span>
						</div>
					</div>

				</div>

			</div>

			<!-- Footer de Tarjeta Destacada -->
			<div class="border-t border-neutral-800/80 pt-4 flex justify-between items-center text-xs font-mono text-gray-400">
				<span>● Circuito Oficial F1</span>
				<span class="text-red-400 bg-red-950/50 px-3 py-1 rounded border border-red-900/60">Estado: Confirmado</span>
			</div>
		</div>


<!-- 2. CARRUSEL DE PILOTOS OFICIALES -->
		<div class="space-y-6">
			<div class="flex justify-between items-end border-b border-neutral-800 pb-4">
				<div>
					<h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white">
						Parrilla de <span class="text-red-600">Pilotos</span>
					</h3>
					<p class="text-gray-500 text-xs font-mono">Los 20 competidores confirmados para la temporada</p>
				</div>
				<span class="hidden sm:block text-xs font-mono text-gray-500">Deslizá para ver más →</span>
			</div>

			<!-- Tira deslizable tipo carrusel -->
			<div class="flex gap-5 overflow-x-auto pb-6 scrollbar-thin scrollbar-thumb-red-600 scrollbar-track-neutral-900 snap-x snap-mandatory">
				{pilotos.map((piloto) => (
					<div class="min-w-[260px] max-w-[260px] bg-[#0d0d0d] rounded-2xl border border-neutral-800 hover:border-red-600/60 transition-all duration-300 p-5 flex flex-col justify-between group relative overflow-hidden snap-start flex-shrink-0">
						
						<!-- Línea superior con el color distintivo del equipo -->
						<div 
							class="absolute top-0 left-0 right-0 h-1" 
							style={`background-color: ${piloto.escuderia.colorHex}`}
						></div>

						<div>
							<!-- Cabecera: Número y Logo de Escudería -->
							<div class="flex justify-between items-center mb-3">
								<span class="text-2xl font-black font-mono text-gray-500 group-hover:text-red-500 transition-colors">
									#{piloto.numero}
								</span>
								<img 
									src={piloto.escuderia.logoEscuderia} 
									alt={piloto.escuderia.nombre} 
									class="h-5 object-contain"
									onerror="this.style.display='none'"
								/>
							</div>

							<!-- Foto del Piloto -->
							<div class="bg-black/60 rounded-xl p-2 border border-neutral-900 mb-4 flex justify-center items-center h-44 overflow-hidden">
								<img 
									src={piloto.fotoPiloto} 
									alt={piloto.nombre} 
									class="h-full object-cover group-hover:scale-105 transition-transform duration-300"
									onerror="this.src='https://via.placeholder.com/150/000000/FFFFFF?text=F1'"
								/>
							</div>

							<!-- Nombre y Escudería -->
							<h4 class="text-lg font-black text-white uppercase tracking-tight truncate">
								{piloto.nombre}
							</h4>
							<p class="text-xs font-mono text-gray-400 mb-4 truncate">
								{piloto.escuderia.nombre}
							</p>
						</div>

						<!-- Detalle Técnico y Redes -->
						<div class="border-t border-neutral-800/80 pt-3 space-y-3 font-mono text-xs">
							<div class="flex justify-between items-center">
								<span class="text-gray-500 uppercase text-[10px]">Controles</span>
								<span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
									piloto.periferico === 'Simulador' 
										? 'bg-red-950/80 text-red-400 border border-red-800' 
										: 'bg-blue-950/80 text-blue-400 border border-blue-800'
								}`}>
									{piloto.periferico}
								</span>
							</div>

							{piloto.instagram && (
								<a 
									href={piloto.instagram} 
									target="_blank" 
									rel="noopener noreferrer"
									class="block text-center w-full py-1.5 bg-neutral-900 hover:bg-red-600/20 hover:border-red-600/40 border border-neutral-800 text-gray-300 hover:text-white rounded-lg transition-all duration-200 uppercase text-[10px] tracking-wider"
								>
									Instagram
								</a>
							)}
						</div>

					</div>
				))}
			</div>
		</div>











		<!-- 3. RESTO DEL CALENDARIO (GRILLA COMPACTA) -->
		<div class="space-y-6">
			<div class="border-b border-neutral-800 pb-4">
				<h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white">
					Próximas Fechas <span class="text-red-600">2026</span>
				</h3>
				<p class="text-gray-500 text-xs font-mono">Resto del calendario oficial de la temporada</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				{restoCarreras.map((carrera) => (
					<div class="bg-[#0c0c0c] hover:bg-[#121212] p-5 rounded-xl border border-neutral-800/80 hover:border-red-900/50 transition-all duration-300 group flex flex-col justify-between">
						<div>
							<div class="flex justify-between items-center mb-3">
								<span class="text-[10px] font-mono text-gray-400 bg-neutral-900 px-2 py-0.5 rounded border border-neutral-800">
									FECHA {carrera.numeroFecha}
								</span>
								<span class="text-xs font-mono text-gray-500">{carrera.fechaGranPremio}</span>
							</div>

							<div class="flex items-center gap-2 mb-1">
								<span class="text-xl">{carrera.bandera}</span>
								<h4 class="font-black text-lg text-white uppercase group-hover:text-red-500 transition-colors">
									{carrera.pais}
								</h4>
							</div>

							<p class="text-xs text-gray-400 font-mono truncate mb-4">{carrera.circuito}</p>
						</div>

						<!-- Mini datos de compuestos -->
						<div class="flex gap-1.5 font-mono text-[10px] text-gray-400 border-t border-neutral-900 pt-3">
							<span class="px-1.5 py-0.5 rounded bg-neutral-900 border border-neutral-800">
								{carrera.compuestos.blando}
							</span>
							<span class="px-1.5 py-0.5 rounded bg-neutral-900 border border-neutral-800">
								{carrera.compuestos.medio}
							</span>
							<span class="px-1.5 py-0.5 rounded bg-neutral-900 border border-neutral-800">
								{carrera.compuestos.duro}
							</span>
						</div>
					</div>
				))}
			</div>
		</div>

	</section>
</Layout>