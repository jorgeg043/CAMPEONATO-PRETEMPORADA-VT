---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section class="min-h-[85vh] flex flex-col items-center justify-center text-center px-4 py-16">
        <div class="max-w-3xl mx-auto space-y-8">
            
            <!-- Badge Superior -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/60 border border-red-800/50 text-red-400 text-xs font-mono uppercase tracking-widest shadow-[0_0_20px_rgba(225,6,0,0.3)]">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                Campeonato F1 25
            </div>

            <!-- Título Principal -->
            <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight text-white leading-none">
                INSCRIPCIÓN <br />
                <span class="bg-gradient-to-r from-red-500 via-red-600 to-red-800 bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(225,6,0,0.6)]">
                    CAMPEONATO PRETEMPORADA 2027 F1 VT
                </span>
            </h1>

            <!-- Descripción -->
            <p class="text-gray-300 font-mono text-base md:text-lg max-w-xl mx-auto">
                Completá el formulario para asegurar tu lugar en la grilla oficial.
            </p>

            <!-- Botón de Google Forms -->
            <div class="pt-4">
                <a
                    href="https://docs.google.com/forms/d/e/1FAIpQLSebFbwAJF2RS-SAx8WFCUnn6lPf55tsH5Q9Z6eWEGg1FNB07w/viewform?usp=publish-editor"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-black py-4 px-8 rounded-xl transition-all duration-300 text-base md:text-lg uppercase tracking-wider shadow-[0_0_25px_rgba(225,6,0,0.5)] hover:shadow-[0_0_40px_rgba(225,6,0,0.8)] hover:-translate-y-1"
                >
                    Ir al formulario
                </a>
            </div>

            <!-- Aviso Inferior -->
            <div class="pt-8 border-t border-neutral-900">
                <p class="text-xs md:text-sm font-mono text-gray-400 uppercase tracking-widest">
                    LA TEMPORADA ARRANCA EN OCTUBRE, <span class="text-red-500 font-bold">¡No te quedes afuera!</span>
                </p>
            </div>

        </div>
    </section>
</Layout>