---
import Layout from '../layouts/Layout.astro';
import pilotosData from '../data/pilotos.json';

// 1. Cargamos todos los archivos de resultados
const archivosCarreras = import.meta.glob('../data/carreras/*.json', { eager: true });
const carrerasCargadas = Object.values(archivosCarreras).map((file: any) => file.default || file);

// 2. Procesamos las estadísticas de cada piloto
const estadisticasPilotos = pilotosData.map((piloto) => {
    let carrerasCorridas = 0;
    let victorias = 0;
    let dnfs = 0;
    let puntosTotales = 0;
    let polePositions = 0;
    let vueltasRapidas = 0;
    let totalParadas = 0;
    let totalAlerones = 0;

    carrerasCargadas.forEach((carrera: any) => {
        // --- POLE POSITION (Común para ambos formatos) ---
        if (carrera.polePosition?.pilotoId === piloto.id) polePositions++;

        if (carrera.formato === 'doble') {
            // ==========================================
            // LÓGICA FECHA ESPECIAL (DOBLE CARRERA)
            // ==========================================
            const PUNTOS_F1 = [0, 25, 18, 15, 12, 10, 8, 6, 4, 2, 1];
            const PUNTOS_CARRERA2 = [0, 8, 7, 6, 5, 4, 3, 2, 1];

            // --- CARRERA 1 ---
            const resC1 = carrera.carrera1?.posiciones?.find((p: any) => p.pilotoId === piloto.id);
            if (resC1) {
                carrerasCorridas++; // Cuenta como una carrera corrida
                if (resC1.dnf) dnfs++;
                if (!resC1.dnf && resC1.posicion === 1) victorias++;
                if (!resC1.dnf && resC1.posicion <= 10) puntosTotales += PUNTOS_F1[resC1.posicion] || 0;
                
                totalParadas += (resC1.paradasBoxes || 0);
                if (resC1.cambioAleron) totalAlerones++;
            }
            if (carrera.carrera1?.vueltaRapida?.pilotoId === piloto.id) vueltasRapidas++;

            // --- CARRERA 2 ---
            const resC2 = carrera.carrera2?.posiciones?.find((p: any) => p.pilotoId === piloto.id);
            if (resC2) {
                carrerasCorridas++; // Cuenta como OTRA carrera corrida
                if (resC2.dnf) dnfs++;
                if (!resC2.dnf && resC2.posicion === 1) victorias++;
                if (!resC2.dnf && resC2.posicion <= 8) puntosTotales += PUNTOS_CARRERA2[resC2.posicion] || 0;

                totalParadas += (resC2.paradasBoxes || 0);
                if (resC2.cambioAleron) totalAlerones++;
            }
            if (carrera.carrera2?.vueltaRapida?.pilotoId === piloto.id) vueltasRapidas++;

        } else {
            // ==========================================
            // LÓGICA CARRERA NORMAL
            // ==========================================
            const resultado = carrera.posiciones?.find((p: any) => p.pilotoId === piloto.id);
            if (resultado) {
                carrerasCorridas++;
                if (resultado.dnf) dnfs++;
                if (!resultado.dnf && resultado.posicion === 1) victorias++;
                
                // Sumamos puntos según posición (Top 10)
                const PUNTOS = [0, 25, 18, 15, 12, 10, 8, 6, 4, 2, 1];
                if (!resultado.dnf && resultado.posicion <= 10) {
                    puntosTotales += PUNTOS[resultado.posicion] || 0;
                }

                // Datos técnicos
                totalParadas += (resultado.paradasBoxes || 0);
                if (resultado.cambioAleron) totalAlerones++;
            }
            if (carrera.vueltaRapida?.pilotoId === piloto.id) vueltasRapidas++;
        }
    });

    // Puntos extra por Pole y VR
    puntosTotales += polePositions + vueltasRapidas;

    const eficiencia = carrerasCorridas > 0 ? ((carrerasCorridas - dnfs) / carrerasCorridas) * 100 : 0;
    const promedioParadas = carrerasCorridas > 0 ? (totalParadas / carrerasCorridas) : 0;

    return { ...piloto, carrerasCorridas, victorias, dnfs, puntosTotales, polePositions, vueltasRapidas, eficiencia, promedioParadas, totalAlerones };
}).sort((a, b) => b.puntosTotales - a.puntosTotales);
---

<Layout>
    <section class="max-w-6xl mx-auto py-12 px-4">
        <!-- Título -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-white">
                Dashboard de <span class="text-red-600">Estadísticas</span>
            </h1>
            <p class="text-gray-400 font-mono text-sm">Rendimiento técnico, telemetría y fiabilidad</p>
        </div>

        <!-- Grilla de Pilotos -->
        <div class="grid grid-cols-1 gap-6">
            {estadisticasPilotos.map((p) => (
                <div class="bg-[#0d0d0d] border border-neutral-800 rounded-2xl p-6 hover:border-red-600/50 transition-all duration-300">
                    <div class="flex flex-col md:flex-row items-center gap-6">
                        
                        <!-- Perfil -->
                        <div class="flex items-center gap-4 w-full md:w-1/4">
                            <img src={p.fotoPiloto} class="w-16 h-16 rounded-full object-cover border-2 border-neutral-700" alt={p.nombre} />
                            <div>
                                <h3 class="font-black text-lg text-white uppercase">{p.nombre}</h3>
                                <div class="flex items-center gap-2 mt-1">
                                    <img src={p.escuderia.logoEscuderia} class="h-5 w-5 object-contain" alt={p.escuderia.nombre} />
                                    <span class="text-[10px] text-gray-500 font-mono uppercase">{p.escuderia.nombre}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Métricas -->
                        <div class="grid grid-cols-2 md:grid-cols-6 gap-6 w-full md:w-3/4 border-l border-neutral-800 pl-6">
                            <div class="space-y-1">
                                <span class="text-[10px] text-gray-500 uppercase">Eficiencia</span>
                                <div class="w-full bg-neutral-900 h-1.5 rounded-full overflow-hidden">
                                    <div class="bg-emerald-500 h-full" style={`width: ${p.eficiencia}%`}></div>
                                </div>
                                <span class="text-[10px] text-white font-mono">{p.eficiencia.toFixed(0)}%</span>
                            </div>
                            
                            <div class="text-center">
                                <span class="block text-[10px] text-gray-500 uppercase">Wins</span>
                                <span class="text-lg font-black text-white">{p.victorias}</span>
                            </div>
                            
                            <div class="text-center">
                                <span class="block text-[10px] text-gray-500 uppercase">Puntos</span>
                                <span class="text-lg font-black text-red-500">{p.puntosTotales}</span>
                            </div>

                            <div class="text-center border-l border-neutral-800">
                                <span class="block text-[10px] text-gray-500 uppercase">Stops Prom.</span>
                                <span class="text-lg font-black text-blue-400">{p.promedioParadas.toFixed(1)}</span>
                            </div>

                            <div class="text-center border-l border-neutral-800">
                                <span class="block text-[10px] text-gray-500 uppercase">Alerones</span>
                                <span class="text-lg font-black text-yellow-500">{p.totalAlerones}</span>
                            </div>

                            <div class="flex gap-2 justify-center items-center border-l border-neutral-800">
                                <div class="text-center">
                                    <span class="block text-[10px] text-gray-500">Pole</span>
                                    <span class="text-md font-black text-purple-400">{p.polePositions}</span>
                                </div>
                                <div class="text-center">
                                    <span class="block text-[10px] text-gray-500">VR</span>
                                    <span class="text-md font-black text-emerald-400">{p.vueltasRapidas}</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>